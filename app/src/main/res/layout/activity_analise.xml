<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tituloAnalise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANÁLISE DE PERFIL"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="20dp"/>

        <!-- Pergunta 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUAL A SUA PROFISSÃO?"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_marginBottom="5dp"/>

        <Spinner
            android:id="@+id/spinnerProfissao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/profissoes"
            android:background="@drawable/bg_spinner_estado"
            android:padding="8dp"
            android:layout_marginBottom="10dp"/>

        <!-- Pergunta 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POSSUI ALGUM VEÍCULO EM SEU NOME?"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"/>

        <Spinner
            android:id="@+id/spinnerVeiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/veiculos"
            android:background="@drawable/bg_spinner_estado"
            android:padding="8dp"
            android:layout_marginBottom="10dp"/>

        <!-- Pergunta 3 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POSSUI CASA EM SEU NOME?"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"/>

        <Spinner
            android:id="@+id/spinnerCasa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/sim_nao"
            android:background="@drawable/bg_spinner_estado"
            android:padding="8dp"
            android:layout_marginBottom="10dp"/>

        <!-- Pergunta 4 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POSSUI CONTA EM QUAL BANCO?"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"/>

        <Spinner
            android:id="@+id/spinnerBanco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/bancos"
            android:background="@drawable/bg_spinner_estado"
            android:padding="8dp"
            android:layout_marginBottom="10dp"/>

        <!-- Pergunta 5 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POSSUI ALGUMA RESTRIÇÃO NO SEU NOME?"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"/>

        <Spinner
            android:id="@+id/spinnerRestricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/sim_nao"
            android:background="@drawable/bg_spinner_estado"
            android:padding="8dp"
            android:layout_marginBottom="20dp"/>

        <!-- BOTÃO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoProximoResumo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Próximo"
            android:layout_marginTop="15dp"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/colorOnPrimary"/>
    </LinearLayout>
</ScrollView>
