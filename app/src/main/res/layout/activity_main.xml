<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:padding="32dp">

    <!-- LOGO (opcional, se quiser adicionar depois) -->

    <!-- MENSAGEM DE BOAS-VINDAS -->

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ AUTORAIO ⚡"
        android:textStyle="bold"
        android:textSize="24sp"
        android:gravity="center"
        android:textColor="#000000" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="217dp"
        android:layout_height="200dp"
        app:srcCompat="@drawable/chatgpt_image_30_10_2025__17_33_34" />

    <TextView
        android:id="@+id/textoBoasVindas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Olá, seja bem-vindo à AUTORAIO ⚡\n\nMeu nome é Maria Clara.\nPara dar seguimento ao atendimento, clique no botão abaixo."
        android:textAlignment="center"
        android:textColor="#222222"
        android:textSize="18sp"
        android:lineSpacingExtra="6dp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp" />


    <!-- BOTÃO -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoIniciar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar Simulação"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:backgroundTint="#2196F3"
        android:textColor="@android:color/white"
        app:cornerRadius="12dp" />

</LinearLayout>
