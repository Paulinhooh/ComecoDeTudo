<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tituloCadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DADOS PESSOAIS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="20dp"/>

        <!-- NOME COMPLETO -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/CampoTransparente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome completo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoNomeCompleto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- DATA DE NASCIMENTO -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/CampoTransparente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Data de Nascimento"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoDataNascimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="date"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- RG -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/CampoTransparente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="RG"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoRG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CPF -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/CampoTransparente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CPF"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoCPF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- GÊNERO -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/CampoTransparente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gênero"
            android:layout_marginTop="8dp">

            <Spinner
                android:id="@+id/spinnerGenero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/generos"
                android:background="@drawable/bg_spinner_estado"
                android:padding="8dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ESTADO CIVIL -->
        <TextView
            android:id="@+id/textoEstadoCivil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16dp"
            android:textColor="@color/black"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/spinnerEstadoCivil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner_estado"
            android:padding="8dp" />

        <!-- NOME DA MÃE -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/CampoTransparente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome da Mãe"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoMae"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- NOME DO PAI -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/CampoTransparente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do Pai"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoPai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- BOTÃO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoProximo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Próximo"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/colorOnPrimary"/>

    </LinearLayout>
</ScrollView>
